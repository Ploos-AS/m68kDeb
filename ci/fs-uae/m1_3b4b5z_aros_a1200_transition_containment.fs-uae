[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5z/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5z/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5z/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5z/logs
screenshots_dir = out/m1-3b4b5z/screenshots

# M1.3b.4b.5z is CI/emulator-only. After the full 5y reversible gate it
# transfers into the exact copied transition entry. The entry disables cache
# and TC, executes PFLUSHA, and loops locally. It contains no Linux jump.
