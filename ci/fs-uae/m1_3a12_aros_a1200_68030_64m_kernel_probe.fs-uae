[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3a12/rom/aros-rom.bin
kickstart_ext_file = out/m1-3a12/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3a12/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a12/logs
screenshots_dir = out/m1-3a12/screenshots

# M1.3a.12 preserves the M1.3a.11 single-DH0 topology and exact kernel-only
# payload, changing only guest memory: 64 MiB Zorro III FastRAM is explicitly
# supplied to the generic 68030/MMU A1200 profile. No initramfs, second hard
# drive, accelerator ROM, or proprietary ROM is present.
