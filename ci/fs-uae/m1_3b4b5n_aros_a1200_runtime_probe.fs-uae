[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5n/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5n/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5n/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5n/logs
screenshots_dir = out/m1-3b4b5n/screenshots

# Reversible 68030 runtime probe only.
# PTEST may execute in supervisor state, but no TC/CRP/SRP/TT write, ATC flush,
# interrupt-mask change, takeover commit, MMU disable or Linux jump is allowed.
