[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5x/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5x/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5x/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5x/logs
screenshots_dir = out/m1-3b4b5x/screenshots

# M1.3b.4b.5x combines the real kernel/initramfs takeover request with the
# copied reversible transition ABI probe in an identity-qualified page.
# The actual transition entry remains uncalled; no MMU/cache mutation or Linux
# jump is attempted.
