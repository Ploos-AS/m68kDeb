[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = internal
uae_cpu_speed = real
hard_drive_0 = out/m1-3a5/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a5/logs
screenshots_dir = out/m1-3a5/screenshots

# M1.3a.4 proved the pinned AROS system crashes during MMU initialization on
# A3000 before Startup-Sequence. Keep the A1200 chipset but explicitly override
# its stock 68EC020 with a generic 68030. FS-UAE derives uae_mmu_model=68030
# from cpu=68030. No accelerator board is selected and no accelerator ROM is
# required by this profile.
#
# Retain real CPU timing, FS-UAE's internal AROS replacement ROM, the same
# pinned nightly system root, writable directory-backed DH0 and PTY capture.
