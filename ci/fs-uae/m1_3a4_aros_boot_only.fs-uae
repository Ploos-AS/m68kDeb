[fs-uae]
amiga_model = A3000
kickstart_file = internal
uae_cpu_speed = real
hard_drive_0 = out/m1-3a4/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a4/logs
screenshots_dir = out/m1-3a4/screenshots

# Controlled M1.3a.4 boundary test. Keep the same A3000, internal AROS ROM,
# real CPU timing, pinned AROS nightly root and PTY serial backend as M1.3a.3.
# The only functional change is that Startup-Sequence contains no amiboot or
# Linux invocation and writes a marker file immediately when reached.
