[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5c/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5c/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5c/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5c/logs
screenshots_dir = out/m1-3b4b5c/screenshots

# M1.3b.4b.5c runs only the reversible final-layout/takeover preflight.
# The isolated 68030 supervisor/commit object is deliberately not linked.
# No interrupt masking, cache/MMU mutation, Linux jump, or handoff is allowed.
