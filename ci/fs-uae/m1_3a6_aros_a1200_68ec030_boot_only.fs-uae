[fs-uae]
amiga_model = A1200
cpu = 68EC030
kickstart_file = internal
uae_cpu_speed = real
hard_drive_0 = out/m1-3a6/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a6/logs
screenshots_dir = out/m1-3a6/screenshots

# M1.3a.5 showed that AROS with a generic 68030+MMU stalls during MMU setup
# before Startup-Sequence. This diagnostic control changes only the CPU/MMU
# capability to 68EC030 (68030 core without internal MMU). It is not a
# supported m68kDeb target and must not be treated as Linux qualification.
