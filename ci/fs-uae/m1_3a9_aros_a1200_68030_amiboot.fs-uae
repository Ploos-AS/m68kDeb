[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3a9/rom/aros-rom.bin
kickstart_ext_file = out/m1-3a9/rom/aros-ext.bin
uae_cpu_speed = real
hard_drive_0 = out/m1-3a9/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
hard_drive_1 = out/m1-3a9/m68kdeb
hard_drive_1_label = m68kDeb
hard_drive_1_read_only = 1
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a9/logs
screenshots_dir = out/m1-3a9/screenshots

# M1.3a.8 qualified this A1200 + generic 68030/MMU topology with the matching
# AROS nightly ROM pair kept outside the writable DH0 directory tree.  M1.3a.9
# now also keeps the amiboot/Linux payload off DH0 and mounts it read-only as
# a separate directory hard drive, so the AROS boot volume remains equivalent
# to the known-good M1.3a.8 boundary apart from Startup-Sequence.
# No proprietary Commodore/Amiga ROM and no accelerator-specific ROM is used.
