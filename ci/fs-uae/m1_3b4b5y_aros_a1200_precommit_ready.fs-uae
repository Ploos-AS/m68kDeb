[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5y/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5y/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5y/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5y/logs
screenshots_dir = out/m1-3b4b5y/screenshots

# M1.3b.4b.5y proves reversible pre-commit readiness for the real payload and
# copied transition layout. The real transition entry and commit remain
# uncalled; no MMU/cache mutation, PFLUSHA, or Linux jump is attempted.
