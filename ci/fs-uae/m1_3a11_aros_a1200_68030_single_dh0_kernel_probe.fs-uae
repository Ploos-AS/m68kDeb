[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3a11/rom/aros-rom.bin
kickstart_ext_file = out/m1-3a11/rom/aros-ext.bin
uae_cpu_speed = real
fast_memory = 8192
zorro_iii_memory = 16384
hard_drive_0 = out/m1-3a11/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
serial_port = /tmp/m68kdeb-fsuae-serial
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3a11/logs
screenshots_dir = out/m1-3a11/screenshots

# Preserve the 8 MiB Zorro II Fast RAM boot baseline and add 16 MiB
# Zorro III RAM for the real m68k BusyBox initramfs. This requires the
# emulated 68030's 32-bit address space; CI must confirm Linux detects it.
