[fs-uae]
amiga_model = A1200
cpu = 68030
kickstart_file = out/m1-3b4b5w/rom/aros-rom.bin
kickstart_ext_file = out/m1-3b4b5w/rom/aros-ext.bin
uae_cpu_speed = real
zorro_iii_memory = 65536
hard_drive_0 = out/m1-3b4b5w/aros-root
hard_drive_0_label = System
hard_drive_0_read_only = 0
fullscreen = 0
window_width = 752
window_height = 576
logs_dir = out/m1-3b4b5w/logs
screenshots_dir = out/m1-3b4b5w/screenshots

# M1.3b.4b.5w loads the actual qualified Linux kernel and initramfs, builds
# the exact takeover request, and proves its payload spans are identity-mapped
# under the observed 68030 TC state. No transition entry or Linux jump occurs.
